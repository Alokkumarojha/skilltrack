// Prisma schema for SkillTrack

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id      String @id @default(cuid())
  clerkId String @unique
  name        String?
  email       String  @unique
  username String? @unique
  
  headline    String?
  bio         String?
  location    String?
  githubUrl   String?
  linkedinUrl String?
  resumeUrl   String?
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills      Skill[]
  goals       Goal[]
  projects    Project[]
  experiences Experience[]
  educations  Education[]
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  level     Int      @default(0)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Goal {
  id          String     @id @default(cuid())
  title       String
  description String?
  progress    Int        @default(0)
  status      GoalStatus @default(NOT_STARTED)
  dueDate     DateTime?
  userId      String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String?
  githubUrl   String?
  liveUrl     String?
  status      ProjectStatus @default(IN_PROGRESS)
  userId      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Experience {
  id          String    @id @default(cuid())
  company     String
  position    String
  description String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  userId      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Education {
  id          String    @id @default(cuid())
  institution String
  degree      String
  field       String?
  description String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  userId      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
